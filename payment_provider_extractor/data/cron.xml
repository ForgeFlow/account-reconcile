<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="extract_settlements" model="ir.cron">
            <field name='name'>Extract Settlements</field>
            <field name="model_id" ref="model_payment_provider" />
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False" />
            <field name="code">model.get_all_settlements()</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="extract_transactions" model="ir.cron">
            <field name='name'>Extract Transactions</field>
            <field name="model_id" ref="model_payment_provider" />
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False" />
            <field name="code">model.get_all_transactions()</field>
        </record>
    </data>
</odoo>
